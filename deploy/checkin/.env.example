HOST=0.0.0.0
PORT=18100
CHECKIN_AMOUNT=50
CHECKIN_TZ=Asia/Shanghai
CHECKIN_RESET_HOUR=12
SUB2API_BASE=http://sub2api:8080
# Scoped admin key with users.balance.write (or legacy admin-* key on older installs)
ADMIN_API_KEY=
# Same Postgres as Sub2API
DATABASE_URL=postgresql://sub2api:CHANGE_ME@postgres:5432/sub2api
STATIC_DIR=/app/static
# Local default; production uses sub2api_sub2api-network
SUB2API_DOCKER_NETWORK=sub2api-local_sub2api-network
